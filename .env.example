# Add these in Vercel → Project → Settings → Environment Variables, then redeploy.

# ── Supabase (Project Settings → Data API / API Keys). Plain, not "Sensitive". ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Secret: mark as "Sensitive" in Vercel. Never share these. ──
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Stripe → Developers → API keys → Secret key (sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
